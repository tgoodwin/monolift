apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ .ServiceName }}
  namespace: {{ .Namespace }}
  labels:
    app.kubernetes.io/name: {{ .ServiceName }}
    discrete.events/experiment: monolift
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ .ServiceName }}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{ .ServiceName }}
        discrete.events/experiment: monolift
      annotations:
        dapr.io/enabled: "true"
        dapr.io/app-id: {{ .ServiceName }}
        dapr.io/app-port: "{{ .ContainerPort }}"
    spec:
      containers:
        - name: {{ .ServiceName }}
          image: {{ .ImageName }}
          ports:
            - containerPort: {{ .ContainerPort }}
          resources:
            requests:
              cpu: "500m"
              memory: "256Mi"
            limits:
              cpu: {{ .CpuLimit }}
              memory: {{ .MemoryLimit }}
          env:
            - name: K8S_CPU_REQUEST
              valueFrom:
                resourceFieldRef:
                  containerName: {{ .ServiceName }}
                  resource: requests.cpu
                  divisor: "1m"
            - name: K8S_CPU_LIMIT
              valueFrom:
                resourceFieldRef:
                  containerName: {{ .ServiceName }}
                  resource: limits.cpu
                  divisor: "1m"
            - name: K8S_MEMORY_REQUEST
              valueFrom:
                resourceFieldRef:
                  containerName: {{ .ServiceName }}
                  resource: requests.memory
            - name: K8S_MEMORY_LIMIT
              valueFrom:
                resourceFieldRef:
                  containerName: {{ .ServiceName }}
                  resource: limits.memory
{{- range .EnvVars }}
            - name: {{ .Name }}
              value: {{ .Value }}
{{- end }}