package main

import (
	"context"
	"encoding/json"
	"fmt"
	"log"
	"net/http"

    {{- range $path, $alias := .Imports }}
	{{- if $alias }}
	{{$alias}} "{{$path}}"
	{{- else }}
	"{{$path}}"
	{{- end }}
    {{- end }}
)

{{range .PackageScopeDeps}}
{{.RenderedForm}}
{{end}}

type {{.ServerStructName}} struct {
    {{.DelegateFieldName}} {{.InterfacePackageAlias}}.{{.InterfaceTypeName}}
}

{{range .Methods}}
// {{.HandlerFuncName}} handles HTTP requests for the {{.Name}} method.
func (s *{{$.ServerStructName}}) {{.HandlerFuncName}}(w http.ResponseWriter, r *http.Request) {
	if r.Method != http.MethodPost {
		http.Error(w, "Only POST method is allowed", http.StatusMethodNotAllowed)
		return
	}

	fmt.Println("Handling request for {{.Name}}")

	var req {{.RequestType}}
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		http.Error(w, fmt.Sprintf("failed to decode request for {{.Name}}: %v", err), http.StatusBadRequest)
		return
	}

	resp, err := s.{{$.DelegateFieldName}}.{{.Name}}(r.Context(), req)
	if err != nil {
		http.Error(w, fmt.Sprintf("service call for {{.Name}} failed: %v", err), http.StatusInternalServerError)
		return
	}

	w.Header().Set("Content-Type", "application/json")
	if err := json.NewEncoder(w).Encode(resp); err != nil {
		// If encoding fails, it's too late to send a different status code.
		log.Printf("failed to encode response for {{.Name}}: %v", err)
	}
}
{{end}}

// Main function to set up the HTTP server
func main() {
    {{range .FunctionScopeDeps}}
	{{.RenderedForm}}
    {{end}}

	// --- Server Setup ---
	// The root dependency is the service delegate we need to wrap.
	serverInstance := &{{.ServerStructName}}{
		{{.DelegateFieldName}}: {{.RootDependency.VarName}},
	}

{{range .Methods}}
    http.HandleFunc("{{.HTTPRoute}}", serverInstance.{{.HandlerFuncName}})
{{end}}
	log.Fatal(http.ListenAndServe(":8080", nil))
}
