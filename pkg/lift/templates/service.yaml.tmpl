apiVersion: v1
kind: Service
metadata:
  name: {{ .ServiceName }}
  namespace: {{ .Namespace }}
  labels: # Recommended labels for Kubernetes
    app.kubernetes.io/name: {{ .ServiceName }}
    discrete.events/experiment: monolift # Custom label for the experiment
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: {{ .ServiceName }}
  ports:
    - name: http
      protocol: TCP
      port: 80 # Standard service port
      targetPort: {{ .TargetPort }}