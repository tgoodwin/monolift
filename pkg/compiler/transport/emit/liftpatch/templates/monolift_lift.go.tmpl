package caddyhttp

import (
	"bytes"
	"encoding/json"
	"log"
	"net/http"
	"os"
	"time"
)

const monoliftLiftFailureSentinel = {{ .FailureSentinel }}

var (
	monoliftLiftEnabled = os.Getenv("{{ .EnvVarPrefix }}") == "on"
