package parser

import (
	"bytes"
	"encoding/json"
	"errors"
	"fmt"
	"net/http"
	"os"
	"time"
)

type monoliftInvokeRequest struct {
	Input string `json:"input"`
}

type monoliftInvokeResponse struct {
	Name  string `json:"name"`
	Count int    `json:"count"`
	Error string `json:"error,omitempty"`
}

type monoliftLocalizedError struct {
	Error   string `json:"error,omitempty"`
	Message string `json:"message,omitempty"`
}

func Parse(input string) (string, int, error) {
	if os.Getenv("MONOLIFT_LIFT_PARSE") != "on" {
		return monoliftOriginalParse(input)
	}
	r0, r1, appErr, transportErr := monoliftRemoteParse(input)
	if transportErr != nil {
		if os.Getenv("MONOLIFT_LIFT_FAILMODE") == "closed" {
			return "", 0, fmt.Errorf("monolift: extracted service unavailable")
		}
		return monoliftOriginalParse(input)
	}
	return r0, r1, appErr
}

func monoliftRemoteParse(input string) (string, int, error, error) {
	endpoint := os.Getenv("MONOLIFT_PARSE_ENDPOINT")
	if endpoint == "" {
		endpoint = "http://127.0.0.1:8081/invoke"
	}
	payload := monoliftInvokeRequest{Input: input}
	var body bytes.Buffer
	if err := json.NewEncoder(&body).Encode(payload); err != nil {
		return "", 0, nil, err
	}
	req, err := http.NewRequest(http.MethodPost, endpoint, &body)
	if err != nil {
		return "", 0, nil, err
	}
	req.Header.Set("Content-Type", "application/json")
	client := &http.Client{Timeout: 30 * time.Second}
	resp, err := client.Do(req)
	if err != nil {
		return "", 0, nil, err
	}
	defer resp.Body.Close()
	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
		return "", 0, nil, errors.New(resp.Status)
	}
	var decoded monoliftInvokeResponse
	if err := json.NewDecoder(resp.Body).Decode(&decoded); err != nil {
		return "", 0, nil, err
	}
	var appErr error
	if decoded.Error != "" {
		appErr = errors.New(decoded.Error)
	}
	return decoded.Name, decoded.Count, appErr, nil
}
