package caddyhttp

import (
	"bytes"
	"encoding/json"
	"errors"
	"fmt"
	"net/http"
	"os"
	"time"
)

type monoliftInvokeRequest struct {
	Receiver TemplateContext `json:"receiver"`
	Input    any             `json:"input"`
}

type monoliftInvokeResponse struct {
	Result string `json:"result"`
	Error  string `json:"error,omitempty"`
}

type monoliftLocalizedError struct {
	Error   string `json:"error,omitempty"`
	Message string `json:"message,omitempty"`
}

func (t TemplateContext) funcMarkdown(input any) (string, error) {
	if os.Getenv("MONOLIFT_LIFT_FUNCMARKDOWN") != "on" {
		return t.monoliftOriginalfuncMarkdown(input)
	}
	result, appErr, transportErr := t.monoliftRemotefuncMarkdown(input)
	if transportErr != nil {
		if os.Getenv("MONOLIFT_LIFT_FAILMODE") == "closed" {
			return "", fmt.Errorf("monolift: extracted service unavailable")
		}
		return t.monoliftOriginalfuncMarkdown(input)
	}
	return result, appErr
}

func (t TemplateContext) monoliftRemotefuncMarkdown(input any) (string, error, error) {
	endpoint := os.Getenv("MONOLIFT_FUNCMARKDOWN_ENDPOINT")
	if endpoint == "" {
		endpoint = "http://127.0.0.1:8081/invoke"
	}
	payload := monoliftInvokeRequest{Receiver: t, Input: input}
	var body bytes.Buffer
	if err := json.NewEncoder(&body).Encode(payload); err != nil {
		return "", nil, err
	}
	req, err := http.NewRequest(http.MethodPost, endpoint, &body)
	if err != nil {
		return "", nil, err
	}
	req.Header.Set("Content-Type", "application/json")
	client := &http.Client{Timeout: 30 * time.Second}
	resp, err := client.Do(req)
	if err != nil {
		return "", nil, err
	}
	defer resp.Body.Close()
	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
		return "", nil, errors.New(resp.Status)
	}
	var decoded monoliftInvokeResponse
	if err := json.NewDecoder(resp.Body).Decode(&decoded); err != nil {
		return "", nil, err
	}
	var appErr error
	if decoded.Error != "" {
		appErr = errors.New(decoded.Error)
	}
	return decoded.Result, appErr, nil
}
