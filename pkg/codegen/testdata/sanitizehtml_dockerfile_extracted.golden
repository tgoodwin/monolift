FROM golang:1.26.0 AS builder

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -mod=mod -o /out/sanitizehtml ./cmd/sanitizehtml

FROM gcr.io/distroless/static-debian12
COPY --from=builder /out/sanitizehtml /sanitizehtml
EXPOSE 8081
ENTRYPOINT ["/sanitizehtml"]
