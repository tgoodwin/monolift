package main

import (
	"database/sql"
	"encoding/json"
	_ "github.com/lib/pq"
	"log"
	"miniflux.app/v2/internal/reader/handler"
	"miniflux.app/v2/internal/storage"
	"net/http"
	"os"
)

type invokeRequest struct {
	UserID       int64 `json:"user_id"`
	FeedID       int64 `json:"feed_id"`
	ForceRefresh bool  `json:"force_refresh"`
}

type invokeResponse struct {
	Error *localizedError `json:"error,omitempty"`
}

type localizedError struct {
	Error   string `json:"error,omitempty"`
	Message string `json:"message,omitempty"`
}

type serverState struct {
	Store *storage.Storage
}

func initState() (*serverState, error) {
	state := &serverState{}
	storeDB, err := sql.Open("postgres", os.Getenv("DATABASE_URL"))
	if err != nil {
		return nil, err
	}
	state.Store = storage.NewStorage(storeDB)
	return state, nil
}

func NewHandler(state *serverState) http.Handler {
	mux := http.NewServeMux()
	mux.HandleFunc("/healthz", func(w http.ResponseWriter, r *http.Request) {
		w.WriteHeader(http.StatusOK)
		_, _ = w.Write([]byte("ok"))
	})
	mux.HandleFunc("/invoke", invokeHandler(state))
	return mux
}

func invokeHandler(state *serverState) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		if r.Method != http.MethodPost {
			http.Error(w, "method not allowed", http.StatusMethodNotAllowed)
			return
		}
		defer r.Body.Close()
		var req invokeRequest
		if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
			http.Error(w, err.Error(), http.StatusBadRequest)
			return
		}
		result := handler.RefreshFeed(state.Store, req.UserID, req.FeedID, req.ForceRefresh)
		var resp invokeResponse
		if result != nil {
			var errText string
			if err := result.Error(); err != nil {
				errText = err.Error()
			}
			resp.Error = &localizedError{Error: errText, Message: result.Translate("en_US")}
		}
		w.Header().Set("Content-Type", "application/json")
		if err := json.NewEncoder(w).Encode(resp); err != nil {
			log.Printf("encode response: %v", err)
		}
	}
}

func main() {
	state, err := initState()
	if err != nil {
		log.Fatal(err)
	}
	addr := os.Getenv("MONOLIFT_HTTP_ADDR")
	if addr == "" {
		addr = ":8081"
	}
	log.Fatal(http.ListenAndServe(addr, NewHandler(state)))
}
