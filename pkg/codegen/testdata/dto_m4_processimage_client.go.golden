package media

import (
	"bytes"
	"encoding/json"
	"errors"
	"fmt"
	"net/http"
	"os"
	"time"
)

type monoliftInvokeRequest struct {
	SrcData []byte `json:"src_data"`
	Typ     string `json:"typ"`
}

type monoliftInvokeResponse struct {
	Data   []byte `json:"data"`
	Width  int    `json:"width"`
	Height int    `json:"height"`
	Error  string `json:"error,omitempty"`
}

type monoliftLocalizedError struct {
	Error   string `json:"error,omitempty"`
	Message string `json:"message,omitempty"`
}

func ProcessImage(srcData []byte, typ string) ([]byte, int, int, error) {
	if os.Getenv("MONOLIFT_LIFT_PROCESSIMAGE") != "on" {
		return monoliftOriginalProcessImage(srcData, typ)
	}
	r0, r1, r2, appErr, transportErr := monoliftRemoteProcessImage(srcData, typ)
	if transportErr != nil {
		if os.Getenv("MONOLIFT_LIFT_FAILMODE") == "closed" {
			return nil, 0, 0, fmt.Errorf("monolift: extracted service unavailable")
		}
		return monoliftOriginalProcessImage(srcData, typ)
	}
	return r0, r1, r2, appErr
}

func monoliftRemoteProcessImage(srcData []byte, typ string) ([]byte, int, int, error, error) {
	endpoint := os.Getenv("MONOLIFT_PROCESSIMAGE_ENDPOINT")
	if endpoint == "" {
		endpoint = "http://127.0.0.1:8081/invoke"
	}
	payload := monoliftInvokeRequest{SrcData: srcData, Typ: typ}
	var body bytes.Buffer
	if err := json.NewEncoder(&body).Encode(payload); err != nil {
		return nil, 0, 0, nil, err
	}
	req, err := http.NewRequest(http.MethodPost, endpoint, &body)
	if err != nil {
		return nil, 0, 0, nil, err
	}
	req.Header.Set("Content-Type", "application/json")
	client := &http.Client{Timeout: 30 * time.Second}
	resp, err := client.Do(req)
	if err != nil {
		return nil, 0, 0, nil, err
	}
	defer resp.Body.Close()
	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
		return nil, 0, 0, nil, errors.New(resp.Status)
	}
	var decoded monoliftInvokeResponse
	if err := json.NewDecoder(resp.Body).Decode(&decoded); err != nil {
		return nil, 0, 0, nil, err
	}
	var appErr error
	if decoded.Error != "" {
		appErr = errors.New(decoded.Error)
	}
	return decoded.Data, decoded.Width, decoded.Height, appErr, nil
}
