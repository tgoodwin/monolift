#!/usr/bin/env bash
set -euo pipefail

REAL_PATH="$(readlink "$0" 2>/dev/null || echo "$0")"
SCRIPT_DIR="$(cd "$(dirname "$REAL_PATH")" && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
VENV="$REPO_DIR/.venv"
ENV_FILE="$REPO_DIR/.env"

# ── bootstrap ──────────────────────────────────────────────────────────
if [ -f "$ENV_FILE" ]; then
    eval "$(grep -v '^#' "$ENV_FILE" | sed 's/^/export /')"
fi

if [ -n "${PORTAL_TOKEN_FILE:-}" ] && [ -z "${PORTAL_TOKEN:-}" ]; then
    expanded=$(eval echo "$PORTAL_TOKEN_FILE")
    # resolve relative paths against the script directory, not CWD
    case "$expanded" in
        /*) ;;
        *)  expanded="$REPO_DIR/$expanded" ;;
    esac
    if [ ! -r "$expanded" ]; then
        echo "error: PORTAL_TOKEN_FILE=$PORTAL_TOKEN_FILE (resolved: $expanded) is not readable" >&2
        exit 1
    fi
    PORTAL_TOKEN=$(cat "$expanded")
    export PORTAL_TOKEN
fi

if [ -z "${PORTAL_TOKEN:-}" ]; then
    cat >&2 <<EOF
error: no CloudLab credentials found.

Set one of these in $ENV_FILE (or in your shell):
  PORTAL_TOKEN=<raw JWT>
  PORTAL_TOKEN_FILE=<path to file containing JWT>   # relative paths resolve against $REPO_DIR

Optional:
  PORTAL_HTTP=<api endpoint>   # default: https://boss.emulab.net:43794
EOF
    exit 1
fi

export PORTAL_HTTP="${PORTAL_HTTP:-https://boss.emulab.net:43794}"

PORTAL_CLI="$VENV/bin/portal-cli"
if [ ! -x "$PORTAL_CLI" ]; then
    echo "error: portal-cli not found. Run:"
    echo "  python3 -m venv $VENV"
    echo "  $VENV/bin/pip install 'portal-api[cli] @ git+https://gitlab.flux.utah.edu/emulab/portal-api.git'"
    exit 1
fi

JQ=$(command -v jq 2>/dev/null || true)
if [ -z "$JQ" ]; then
    echo "error: jq is required (brew install jq)" >&2
    exit 1
fi

# Bound every portal-cli call so a wedged CloudLab API surfaces as a clear
# error instead of a silent hang. Override with CL_TIMEOUT=<seconds>.
CL_TIMEOUT="${CL_TIMEOUT:-20}"
TIMEOUT_BIN=$(command -v gtimeout 2>/dev/null || command -v timeout 2>/dev/null || true)

portal() {
    if [ -n "$TIMEOUT_BIN" ]; then
        "$TIMEOUT_BIN" "$CL_TIMEOUT" "$PORTAL_CLI" "$@"
        local rc=$?
        if [ "$rc" -eq 124 ] || [ "$rc" -eq 137 ]; then
            echo "error: portal-cli $* timed out after ${CL_TIMEOUT}s (CloudLab API at $PORTAL_HTTP may be unresponsive)" >&2
        fi
        return $rc
    else
        "$PORTAL_CLI" "$@"
    fi
}

# ── helpers ────────────────────────────────────────────────────────────
bold()  { printf '\033[1m%s\033[0m' "$*"; }
dim()   { printf '\033[2m%s\033[0m' "$*"; }
green() { printf '\033[32m%s\033[0m' "$*"; }
red()   { printf '\033[31m%s\033[0m' "$*"; }
yellow(){ printf '\033[33m%s\033[0m' "$*"; }

status_color() {
    case "$1" in
        ready|provisioned) green "$1" ;;
        failed|error)      red "$1" ;;
        *)                 yellow "$1" ;;
    esac
}

set_default_list_args() {
    LIST_ARGS=()

    # CloudLab's unfiltered /experiments endpoint can hang. For the normal
    # developer workflow, list the current user's experiments by default.
    local creator="${CL_LIST_CREATOR:-${USER:-}}"
    local project="${CL_LIST_PROJECT:-}"

    if [ -n "$creator" ] && [ "$creator" != "all" ]; then
        LIST_ARGS+=(--creator "$creator")
    fi
    if [ -n "$project" ] && [ "$project" != "all" ]; then
        LIST_ARGS+=(--project "$project")
    fi
}

# resolve experiment id: accept UUID or prefix-match on name
require_arg() {
    if [ -z "${2:-}" ]; then
        echo "usage: cl $1" >&2
        exit 1
    fi
}

resolve_exp() {
    local input="$1"
    # already a UUID
    if [[ "$input" =~ ^[0-9a-f]{8}-[0-9a-f]{4}- ]]; then
        echo "$input"
        return
    fi
    # match by name substring
    set_default_list_args
    local id
    id=$(portal experiment list "${LIST_ARGS[@]}" \
        | $JQ -r --arg q "$input" '.experiments[] | select(.name | test($q; "i")) | .id' \
        | head -1)
    if [ -z "$id" ]; then
        echo "error: no experiment matching '$input'" >&2
        return 1
    fi
    echo "$id"
}

# extract SSH hostname from experiment manifests (XML inside JSON)
get_ssh_host() {
    local id="$1"
    local manifests
    manifests=$(portal experiment manifests get --experiment-id "$id" 2>/dev/null || true)
    [ -z "$manifests" ] && return
    echo "$manifests" | $JQ -r 'to_entries[].value' 2>/dev/null \
        | sed -n 's/.*login[^>]*hostname="\([^"]*\)".*/\1/p' \
        | head -1 || true
}

# ── commands ───────────────────────────────────────────────────────────
cmd_ls() {
    local creator="${CL_LIST_CREATOR:-${USER:-}}"
    local project="${CL_LIST_PROJECT:-}"
    while [ $# -gt 0 ]; do
        case "$1" in
            --all)
                creator="all"
                project="all"
                shift ;;
            --creator)
                if [ -z "${2:-}" ]; then
                    echo "usage: cl ls [--all] [--creator <user|all>] [--project <project|all>]" >&2
                    exit 1
                fi
                creator="$2"
                shift 2 ;;
            --creator=*)
                creator="${1#--creator=}"
                shift ;;
            --project)
                if [ -z "${2:-}" ]; then
                    echo "usage: cl ls [--all] [--creator <user|all>] [--project <project|all>]" >&2
                    exit 1
                fi
                project="$2"
                shift 2 ;;
            --project=*)
                project="${1#--project=}"
                shift ;;
            *)
                echo "unknown cl ls option: $1" >&2
                echo "usage: cl ls [--all] [--creator <user|all>] [--project <project|all>]" >&2
                exit 1 ;;
        esac
    done

    LIST_ARGS=()
    if [ -n "$creator" ] && [ "$creator" != "all" ]; then
        LIST_ARGS+=(--creator "$creator")
    fi
    if [ -n "$project" ] && [ "$project" != "all" ]; then
        LIST_ARGS+=(--project "$project")
    fi

    local raw rc
    raw=$(portal experiment list "${LIST_ARGS[@]}") || rc=$?
    if [ -n "${rc:-}" ] || [ -z "$raw" ]; then
        echo "error: 'portal-cli experiment list' failed (rc=${rc:-0}, empty output)" >&2
        exit 1
    fi
    local count
    count=$(echo "$raw" | $JQ '.experiments | length' 2>/dev/null || echo 0)

    if [ "$count" -eq 0 ]; then
        echo "No active experiments."
        return
    fi

    echo "$raw" | $JQ -r '.experiments[] | [.name, .status, .profile_name, .bindings.hardware_type // "?", .expires_at, .id] | @tsv' \
        | while IFS=$'\t' read -r name status profile hw expires id; do
            expires_short=$(echo "$expires" | sed 's/T/ /;s/+00:00/ UTC/')
            printf "  %-30s  %s  %-20s  %-12s  %s\n" \
                "$(bold "$name")" "$(status_color "$status")" "$profile" "$hw" "$(dim "$expires_short")"
            printf "  %s\n\n" "$(dim "$id")"
        done
}

cmd_status() {
    require_arg "status <name|id>" "${1:-}"
    local id
    id=$(resolve_exp "$1")
    local raw
    raw=$(portal experiment get --experiment-id "$id")

    echo "$raw" | $JQ -r '
        "  Name:      \(.name)",
        "  Status:    \(.status)",
        "  Profile:   \(.profile_name)",
        "  Hardware:  \(.bindings.hardware_type // "?")",
        "  Image:     \(.bindings.os_image // "?")",
        "  Project:   \(.project)",
        "  Created:   \(.created_at)",
        "  Expires:   \(.expires_at)",
        "  Repo:      \(.repository_url // "n/a")",
        "  Ref:       \(.repository_refspec // "n/a")",
        "  ID:        \(.id)"
    '

    local host
    host=$(get_ssh_host "$id")
    if [ -n "$host" ]; then
        echo
        echo "  SSH:       ssh ${USER}@${host}"
    fi
}

cmd_ssh() {
    require_arg "ssh <name|id>" "${1:-}"
    local id
    id=$(resolve_exp "$1")
    local host
    host=$(get_ssh_host "$id")
    if [ -z "$host" ]; then
        echo "error: could not determine SSH hostname (experiment may still be provisioning)" >&2
        exit 1
    fi
    echo "Connecting to $host ..."
    exec ssh "${USER}@${host}"
}

cmd_extend() {
    local id hours
    require_arg "extend <name|id> [hours]" "${1:-}"
    id=$(resolve_exp "$1")
    hours="${2:-16}"
    portal experiment extend --experiment-id "$id" --extend-by "$hours" >/dev/null
    echo "Extended by ${hours}h."
    cmd_status "$id"
}

cmd_terminate() {
    local id
    require_arg "terminate <name|id>" "${1:-}"
    id=$(resolve_exp "$1")
    read -rp "Terminate experiment $id? [y/N] " confirm
    if [[ "$confirm" =~ ^[Yy] ]]; then
        portal experiment terminate --experiment-id "$id"
        echo "Terminated."
    else
        echo "Cancelled."
    fi
}

cmd_create() {
    local name="${1:-monolift-build}"
    local project="${2:-DVM}"
    local hours="${3:-16}"

    echo "Creating experiment '${name}' (project=${project}, duration=${hours}h) ..."
    local raw
    raw=$(portal experiment create \
        --name "$name" \
        --project "$project" \
        --profile-name monolift-buildserver \
        --profile-project "$project" \
        --duration "$hours")
    local id
    id=$(echo "$raw" | $JQ -r '.id')
    echo "Created: $id"
    echo "Waiting for provisioning ..."

    local status="unknown"
    while true; do
        sleep 15
        status=$(portal experiment get --experiment-id "$id" 2>/dev/null | $JQ -r '.status')
        printf "  %s\n" "$(status_color "$status")"
        case "$status" in
            ready|provisioned) break ;;
            failed|error)
                echo "Experiment failed to provision." >&2
                exit 1 ;;
        esac
    done

    cmd_status "$id"
}

cmd_raw() {
    "$PORTAL_CLI" "$@"
}

# ── dispatch ───────────────────────────────────────────────────────────
usage() {
    cat <<EOF
$(bold "cl") — CloudLab experiment manager for monolift

$(bold "Usage:")
  cl ls                          List experiments
  cl status <name|id>            Experiment details + SSH info
  cl ssh <name|id>               SSH into the build node
  cl create [name] [project] [hours]
                                 Create from monolift-buildserver profile
  cl extend <name|id> [hours]    Extend expiration (default: 16h)
  cl terminate <name|id>         Tear down an experiment
  cl raw <portal-cli args...>    Pass-through to portal-cli

$(bold "Environment:")
  PORTAL_TOKEN or PORTAL_TOKEN_FILE   API token (reads from .env)
  PORTAL_HTTP                         API endpoint
EOF
}

case "${1:-help}" in
    ls|list)     shift; cmd_ls "$@" ;;
    status|st)   shift; cmd_status "$@" ;;
    ssh)         shift; cmd_ssh "$@" ;;
    create)      shift; cmd_create "$@" ;;
    extend|ext)  shift; cmd_extend "$@" ;;
    terminate)   shift; cmd_terminate "$@" ;;
    raw)         shift; cmd_raw "$@" ;;
    help|-h|--help) usage ;;
    *)           echo "Unknown command: $1"; usage; exit 1 ;;
esac
